# ---------------------------------------------------------------------------
# CYCLO DAKAR — Application web
# Copiez ce fichier en `.env`. Toutes les variables exposees au navigateur
# DOIVENT commencer par VITE_ ; n'y mettez jamais de secret.
# ---------------------------------------------------------------------------

# Base de l'API. En developpement, laissez la valeur relative : Vite relaie
# /api vers Laravel (voir vite.config.ts), donc pas de CORS.
VITE_API_URL=/api/v1

# Cible du proxy de developpement (le `php artisan serve` du backend).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# En production, remplacez par l'URL publique de l'API :
# VITE_API_URL=https://api.cyclodakar.sn/api/v1

VITE_APP_NAME="Cyclo Dakar"
