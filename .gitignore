# ---------------------------------------------------------------------------
# Cyclo Dakar — fichiers ignorés à la racine du dépôt
# Chaque sous-projet (backend, web, mobile, services) a son propre .gitignore.
# ---------------------------------------------------------------------------

# Secrets : jamais dans le dépôt. Seuls les .env.example sont versionnés.
.env
.env.*
!.env.example

# Dépendances
node_modules/
vendor/

# Constructions
dist/
build/
.expo/
*.tsbuildinfo

# Uploads et fichiers générés en local
storage/app/public/*
!storage/app/public/.gitkeep
services/storage/video/*
!services/storage/video/.gitkeep

# Sauvegardes de base
database/dumps/*.sql
!database/dumps/.gitkeep

# Outils et systèmes
.DS_Store
Thumbs.db
desktop.ini
*.log
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# Harnais de rendu headless (jsdom) : bundle IIFE et sa configuration, tous
# deux regeneres a la demande. Ils n'ont rien a faire dans le depot.
web/dist-rendertest/
web/vite.rendertest.config.ts

# Web construit et depose dans Laravel par `php artisan cyclo:build-web`.
# C'est un artefact : il se reconstruit en une commande, et le versionner
# ferait entrer 1,3 Mo de fichiers minifies a chaque changement d'un pixel.
backend/public/app/
backend/public/assets/
backend/public/brand/
backend/public/favicon.svg
backend/public/icons.svg

# Binaire cloudflared, telecharge a la demande par demarrer-demo.ps1.
tools/
