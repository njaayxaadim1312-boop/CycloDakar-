###############################################################################
# CYCLO DAKAR — Backend Laravel
# Copiez ce fichier en `.env` puis lancez `php artisan key:generate`
###############################################################################

APP_NAME="Cyclo Dakar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
# Repli en anglais : une regle de validation non traduite affiche alors
# un message anglais correct plutot qu'une cle brute (validation.min.string).
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
# Les dates sont STOCKEES en UTC et affichees en heure de Dakar.
APP_TIMEZONE=UTC
CLUB_TIMEZONE=Africa/Dakar

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Journalisation -----------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données (XAMPP / MariaDB par défaut) -----------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cyclo_dakar
DB_USERNAME=root
DB_PASSWORD=

# --- Sessions, cache, files d'attente ----------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Authentification API (Sanctum) ------------------------------------------
# Domaines autorisés pour l'authentification par cookie (web en dev).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
# Durée de vie des tokens mobiles, en minutes (null = illimité).
SANCTUM_TOKEN_EXPIRATION=

# --- CORS : origines autorisées à appeler l'API -------------------------------
# Web en dev (Vite) + Expo. Séparer par des virgules.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://localhost:19006

# --- Service Node.js (vidéo + temps réel) -------------------------------------
NODE_SERVICE_URL=http://localhost:4000
# Secret partagé Laravel <-> Node pour signer les échanges (HMAC SHA-256).
# Générez-en un avec :  php artisan cyclo:generate-service-secret
NODE_SERVICE_SECRET=

# --- Cartographie -------------------------------------------------------------
# osm | mapbox
MAP_PROVIDER=osm
MAPBOX_TOKEN=

# Reverse-geocoding des zones traversées (Nominatim = gratuit, 1 req/s max).
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Obligatoire par la politique d'usage de Nominatim : mettez un contact réel.
NOMINATIM_USER_AGENT="CycloDakar/1.0 (contact@cyclodakar.sn)"

# --- Règles métier du club ----------------------------------------------------
# Préfixe des matricules membres : CD-000001
CLUB_MATRICULE_PREFIX=CD
CLUB_CURRENCY=XOF
# Au-delà de ce montant (FCFA), une dépense exige une approbation explicite.
EXPENSE_APPROVAL_THRESHOLD=25000
# Le solde de la caisse est-il visible par tous les membres ?
FINANCE_PUBLIC_BALANCE=false

# --- Uploads ------------------------------------------------------------------
UPLOAD_MAX_SIZE_KB=10240
UPLOAD_ALLOWED_IMAGE_MIMES=image/jpeg,image/png,image/webp
UPLOAD_ALLOWED_DOC_MIMES=application/pdf

# --- Mail ---------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@cyclodakar.sn"
MAIL_FROM_NAME="${APP_NAME}"

# --- Notifications push (phase 17) -------------------------------------------
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# --- Compte administrateur créé par le seeder --------------------------------
SEED_ADMIN_EMAIL=admin@cyclodakar.sn
SEED_ADMIN_PASSWORD=CycloDakar2026!
SEED_ADMIN_PHONE=770000000

VITE_APP_NAME="${APP_NAME}"
