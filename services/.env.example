# ---------------------------------------------------------------------------
# CYCLO DAKAR — Service Node.js (temps reel + rendu video)
# Copiez ce fichier en `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# API Laravel que ce service rappelle en fin de rendu.
LARAVEL_API_URL=http://127.0.0.1:8000

# DOIT etre IDENTIQUE a NODE_SERVICE_SECRET dans backend/.env.
# Toutes les requetes Laravel <-> Node sont signees en HMAC-SHA256 avec ce secret.
SERVICE_SECRET=

# Fenetre de tolerance de l'horodatage des signatures (anti-rejeu), en secondes.
SIGNATURE_TOLERANCE_S=300

# Origines autorisees pour le WebSocket.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rendu video (phase 15) -------------------------------------------------
VIDEO_WORK_DIR=./storage/video
FFMPEG_PATH=ffmpeg
VIDEO_CONCURRENCY=1
